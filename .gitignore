# Игнорируем папку виртуального окружения, чтобы не отправлять тяжелые служебные файлы в архив или Git.
venv/
# Игнорируем еще один частый вариант имени виртуального окружения.
.venv/
# Игнорируем кэш Python-файлов.
__pycache__/
# Игнорируем скомпилированные Python-файлы.
*.pyc
# Игнорируем локальную базу данных SQLite.
db.sqlite3
# Игнорируем файл с секретами и токенами.
.env
# Игнорируем системную папку настроек PyCharm.
.idea/