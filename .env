# Указываем токен Telegram-бота, который вы получите у BotFather.
TELEGRAM_BOT_TOKEN=8347851359:AAF59iIJiF...............Aac
# Указываем базовый адрес Django API, куда бот будет отправлять запросы.
DJANGO_API_BASE_URL=http://127.0.0.1:8000/api